# Configuration Django pour Facturation PME
# Variables d'environnement générées par Ansible

DJANGO_SETTINGS_MODULE=finance_manager.settings
SECRET_KEY={{ secret_key }}
DEBUG=False
ALLOWED_HOSTS={{ allowed_hosts }}

# Base de données PostgreSQL
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_HOST={{ db_host }}
DB_PORT=5432

# Configuration email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER={{ vault_email_user }}
EMAIL_HOST_PASSWORD={{ vault_email_password }}

# Configuration sécurité
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Configuration application
APP_ENV={{ django_env }}
